# DealFlow Environment Variables
# Set these in Railway dashboard under Variables

# REQUIRED
ANTHROPIC_API_KEY=your_anthropic_api_key_here   # Claude AI scoring + photo analysis
APIFY_API_KEY=your_apify_api_key_here             # Zillow scraping via Apify

# REQUIRED for email alerts
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASSWORD=your_gmail_app_password           # Gmail App Password (not regular password)
ALERT_EMAIL=your_email@gmail.com                 # Where deal alerts get sent

# AUTO-SET by Railway (add Postgres plugin)
DATABASE_URL=                                    # Leave empty for local SQLite

# OPTIONAL
PORT=8080                                        # Railway sets this automatically
FLASK_DEBUG=0
DASHBOARD_PASSWORD=your_password_here             # Login password for dashboard
FLASK_SECRET_KEY=your_random_secret_key           # Session encryption key

# BUILDER ZONES (off by default — see NOTES-builder-zones.md)
BUILDER_ZONES_ENABLED=false                      # true schedules both daily jobs on the worker
BUILDER_ZONE_ZIPS=                               # comma list, e.g. 92503,92505 — empty = all 74 IE zips
BUILDER_ZONE_RADIUS_MILES=0.5                    # how close a listing must be to a new build
BUILDER_ZONE_MAX_PAGES=2                         # search pages per zip — EACH PAGE IS A BILLABLE CALL
BUILDER_ZONE_SEARCH_TTL=7200                     # zip-search cache seconds (keep above the 30-min job gap)
BUILDER_ZONE_EXCLUDE_HOME_TYPES=MANUFACTURED     # new-build types that don't count as a builder zone
BUILDER_ZONE_MAX_EMAIL_ROWS=50                   # matches per digest email
